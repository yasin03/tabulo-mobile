# RevenueCat (PROMPT.md 6.8). `.env` dosyasına kopyalayıp doldurun; `.env` git'e girmez.
# Panel → Project Settings → API keys.

# Test Store anahtarı (test_…): yalnızca geliştirme derlemesinde kullanılır, mağaza kurulumu gerekmez.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# Mağaza anahtarları (appl_… / goog_…): sürüm derlemesi bunları kullanır (Faz 10).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
